generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Two connection strings, because the app and the migration tooling need
// different pooling modes:
//
//   DATABASE_URL — the *transaction* pooler (port 6543, `?pgbouncer=true`).
//     Serverless functions each hold a connection while they run, and the
//     session pooler caps that at 15 clients, which is what took production
//     down with `FATAL: max clients reached in session mode`. Transaction mode
//     hands a connection back after each statement, so it survives real
//     concurrency. `pgbouncer=true` disables prepared statements, which a
//     transaction pooler cannot support.
//
//   DIRECT_URL — the *session* pooler (port 5432). Prisma Migrate needs a
//     single sticky session and cannot run through a transaction pooler.
//     Not the `db.<ref>.supabase.co` host, which is IPv6-only (see AGENTS.md).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  UNPAID
  PAID
  ADMIN
}

enum CreativeStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
  FLAGGED
}

enum BookmarkType {
  PROFILE
  POST
}

enum ContactRequestStatus {
  PENDING
  FORWARDED
  ACCEPTED
  DECLINED
  UNAVAILABLE
}

enum FeatureRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostCategory {
  RECENT_WORK
  SEEKING_FUNDING
  SEEKING_COLLABORATORS
  AVAILABLE_FOR_WORK
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  CONGRATULATIONS
  INTERESTED
  SUPPORT
  SHARING_THIS
}

enum CommentReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String?
  role               UserRole  @default(UNPAID)
  earlyAccess        Boolean   @default(false)   // registered before public launch
  stripeCustomerId   String?   @unique
  stripeSubId        String?   @unique
  subStatus          String?                      // active | past_due | canceled | …
  subCurrentPeriodEnd DateTime?
  // Brute-force throttling. Reset on a successful sign-in; while lockedUntil is
  // in the future, sign-in is refused regardless of whether the password is
  // right, so an attacker can't grind an unlimited number of guesses.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contactRequests ContactRequest[]
  creative        Creative?
  bookmarks       Bookmark[]
  enrollmentDraft EnrollmentDraft?
}

/// A partially-completed enrollment application, saved by a signed-in user so
/// they can come back and finish it later (08/08 client round) — available to
/// free and paid accounts alike. One draft per user, removed once the
/// application is actually submitted.
///
/// `data` is the serialized form state and is deliberately schemaless: the
/// enrollment form's field set changes between feedback rounds, and a
/// half-finished application has no business satisfying Creative's constraints
/// (required bio length, experience level, and so on).
model EnrollmentDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Creatives ────────────────────────────────────────────────────────────────

model Creative {
  id        String         @id @default(cuid())
  slug      String         @unique
  status    CreativeStatus @default(PENDING)

  // Links this listing to a login, when the creative is also a paid PCC member —
  // required to post/comment/react on the Community Dashboard, which pulls
  // name/role/profile link from this record. Nullable: most listed creatives
  // don't have (or need) a User login at all.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // ── Public (unpaid) ────────────────────────────────────────────────────────
  firstName       String
  lastName        String
  pronouns        String?
  bio             String        @db.Text
  publicLink      String?       // single link chosen by creative
  location        String?       // city/state — safe to show publicly, distinct from full `address`
  roles           String[]      // shown publicly as a combined pill; shown individually to paid users
  experienceLevel String?       // shown publicly as a badge

  // ── Paid tier ──────────────────────────────────────────────────────────────
  headshot              String?
  mediums               String[]
  workSamples           Json?    // [{title, medium, year, role, link}]
  notableAchievements   String?  @db.Text
  languages             String[]
  availability          String?
  preferredProjectTypes String[]
  previousCollaborators String?  @db.Text
  rateStructure         String?
  rateRange             String?
  ratePublic            Boolean  @default(false)
  website               String?
  imdb                  String?
  instagram             String?
  linkedin              String?
  vimeo                 String?
  travel                String?  // e.g. "Will travel/open to international work"
  education             String?  @db.Text

  // ── Admin only ─────────────────────────────────────────────────────────────
  email                    String
  phone                    String?
  address                  String?
  unionMemberships         String?
  references               String?  @db.Text
  equipment                String?  @db.Text
  collaborationPreferences String?
  pccGoals                 String?  @db.Text
  referralName             String?
  adminNotes               String?  @db.Text
  promoConsent             Boolean  @default(false) // opted in to being used in public-launch social promo

  // ── Featured ───────────────────────────────────────────────────────────────
  featured      Boolean   @default(false)
  featuredUntil DateTime?

  // ── Community Dashboard moderation ─────────────────────────────────────────
  commentSuspended Boolean @default(false) // admin-set: blocked from posting new comments
  commentFlagged   Boolean @default(false) // admin-set: flagged for repeated comment removals

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactRequests ContactRequest[]
  featureRequests FeatureRequest[]
  posts           Post[]           @relation("PostAuthor")
  reactions       Reaction[]       @relation("ReactionAuthor")
  comments        Comment[]        @relation("CommentAuthor")
  commentReports  CommentReport[]  @relation("CommentReporter")
  bookmarkedBy    Bookmark[]       @relation("BookmarkedCreative")
}

// ─── Contact Requests ────────────────────────────────────────────────────────

model ContactRequest {
  id               String               @id @default(cuid())
  userId           String
  creativeId       String
  user             User                 @relation(fields: [userId], references: [id])
  creative         Creative             @relation(fields: [creativeId], references: [id])

  // ── About You ──────────────────────────────────────────────────────────────
  requesterName    String
  requesterEmail   String
  company          String?
  requesterRole    String?
  portfolioLink    String?
  experienceLevel  String               // Emerging | Developing | Established | Accomplished | Veteran

  // ── Request ────────────────────────────────────────────────────────────────
  requestType      String               // General Connection | Collaboration Opportunity | Script Feedback | PR / Press Request | Work for Hire | Other
  requestTypeOther String?
  message          String               @db.Text
  timeline         String               // Immediately/ASAP | Within next month | Within next 3 months | Within next 6 months | No set timeline

  status           ContactRequestStatus @default(PENDING)
  creativeResponse String?
  adminNotes       String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// ─── Feature Requests ────────────────────────────────────────────────────────

model FeatureRequest {
  id         String               @id @default(cuid())
  creativeId String
  creative   Creative             @relation(fields: [creativeId], references: [id])
  reason     String               @db.Text
  status     FeatureRequestStatus @default(PENDING)
  adminNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

// ─── Community Dashboard (paid members only) ────────────────────────────────

model Post {
  id         String       @id @default(cuid())
  creativeId String
  creative   Creative     @relation("PostAuthor", fields: [creativeId], references: [id])

  category   PostCategory
  title      String
  body       String       @db.Text // 500 words max, enforced in the action
  region     String? // required for AVAILABLE_FOR_WORK; optional otherwise
  expiresAt  DateTime? // required for AVAILABLE_FOR_WORK / SEEKING_COLLABORATORS — drives auto-expiry
  link       String? // attachment or project link

  status     PostStatus @default(PENDING)
  adminNotes String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]
  comments  Comment[]
  bookmarkedBy Bookmark[] @relation("BookmarkedPost")
}

model Reaction {
  id         String       @id @default(cuid())
  postId     String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  creativeId String
  creative   Creative     @relation("ReactionAuthor", fields: [creativeId], references: [id])
  type       ReactionType
  createdAt  DateTime     @default(now())

  @@unique([postId, creativeId]) // one reaction per member per post
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  creativeId String
  creative   Creative @relation("CommentAuthor", fields: [creativeId], references: [id])
  body       String   @db.Text // 300 words max, enforced in the action
  isRemoved  Boolean  @default(false) // report-and-remove moderation; live immediately otherwise

  createdAt DateTime @default(now())

  reports CommentReport[]
}

model CommentReport {
  id         String              @id @default(cuid())
  commentId  String
  comment    Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  creativeId String
  creative   Creative            @relation("CommentReporter", fields: [creativeId], references: [id])
  status     CommentReportStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  @@unique([commentId, creativeId]) // a member can only report a given comment once
}

// ─── Bookmarks (paid members only) ──────────────────────────────────────────

model Bookmark {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   BookmarkType

  creativeId String?
  creative   Creative? @relation("BookmarkedCreative", fields: [creativeId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?     @relation("BookmarkedPost", fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, creativeId])
  @@unique([userId, postId])
}
